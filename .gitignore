# build listings and Python caches (and the maps the bench tools leave:
# hot.py's LCMD workloads, mkrun.py -l)
*.LST
*.lst
os/src/LCMD.MAP
os/apps/*.MAP
__pycache__/
*.pyc

# ROM and disk images are not ours to publish: keep them out
# (the tests read the GRiD MS-DOS EPROM image from GRID_ROM or rom/)
rom/*.BIN
rom/*.bin
*.img
*.IMG

# the bridge's local settings and key
claude-link/config.toml
claude-link/api_key

# test-only Node packages (jsdom for the stand-in Firefox; package-lock.json is kept)
claude-link/tests/node_modules/
