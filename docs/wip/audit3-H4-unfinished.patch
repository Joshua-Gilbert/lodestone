+def checker(results, cut=None, flush=False):
+    """A suite's check(name, cond, detail=''): (name, ok) into that suite's own results, and its line printed,
+    with detail (its first `cut` characters) only when it failed."""
+    def check(name, cond, detail=''):
+        results.append((name, bool(cond)))
+        print('%s  %s%s' % ('ok  ' if cond else 'FAIL', name,
+                            ('  -- ' + str(detail)[:cut]) if detail and not cond else ''), flush=flush)
+    return check
+
+
+def row_off(y):
+    """Mode 40h's pixel row y: its offset in B800h (4 banks of 2000h, 80 bytes a row)."""
+    return (y & 3) * 0x2000 + (y >> 2) * 80
+
+
+def mcb_chain(pc, seg, namelen=2, most=None):
+    """The MCBs from seg: [(segment, type byte, owner, paragraphs, its first namelen name bytes)], up to and with
+    the first not 'M' (or `most` + 1 of them)."""
+    out = []
+    while True:
+        t = pc.rd(seg, 0, 1)[0]
+        out.append((seg, t, pc.u16(seg, 1), pc.u16(seg, 3), pc.rd(seg, 8, namelen)))
+        if t != ord('M') or (most is not None and len(out) > most): return out
+        seg += pc.u16(seg, 3) + 1
 
 
